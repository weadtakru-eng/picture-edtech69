rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Helper function
    function isSignedIn() {
      return request.auth != null;
    }

    // Default deny catch-all
    match /{document=**} {
      allow read, write: if false;
    }

    // Users collection: PII strictly protected. Public visitor CANNOT read users.
    match /users/{userId} {
      allow read: if isSignedIn();
      allow write: if isSignedIn() && request.auth.uid == userId;
    }

    // Albums collection: Public visitor can read ONLY published active albums.
    // Source of Truth is `isPublished == true`.
    // Safe compatibility fallback for legacy documents without isPublished: isShared == true.
    match /albums/{albumId} {
      allow get: if isSignedIn() || (
        (resource.data.isPublished == true || (resource.data.isPublished == null && resource.data.isShared == true)) && 
        resource.data.accessLevel != 'disabled' &&
        resource.data.accessLevel != 'private'
      );
      allow list: if isSignedIn() || (
        resource.data.isPublished == true
      );
      allow create, update, delete: if isSignedIn();
    }

    // Photos collection: Public can read photos belonging to shared albums.
    // Public CANNOT write photos.
    match /photos/{photoId} {
      allow read: if isSignedIn() || resource.data.albumId != null;
      allow create, update, delete: if isSignedIn();
    }

    // Share links: Public visitor can lookup share link tokens.
    // Public CANNOT create, update or delete shareLinks.
    match /shareLinks/{linkId} {
      allow read: if true;
      allow create, update, delete: if isSignedIn();
    }

    // Activity logs: Audit log strictly internal to staff.
    // Public visitor CANNOT read, delete, or tamper with activityLogs.
    match /activityLogs/{logId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn();
      allow update, delete: if false;
    }
  }
}
